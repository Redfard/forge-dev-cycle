#!/usr/bin/env python3
"""forge-waiting — mark that a session is waiting for input, and clear the mark.

    forge-waiting set    < JSON of the Notification hook
    forge-waiting clear  < JSON of the UserPromptSubmit, Stop and SessionEnd hooks
    forge-waiting list

The mark must be cleared by three hooks. UserPromptSubmit catches an answer to a question, but granting
permission for a command is not a message — only Stop fires there,
when the session finished its answer, and SessionEnd fires when the session closed. The order
is safe: Stop comes before the idle time, and Notification after it. Nobody reports a session
that was killed hard: such a mark is wiped out after an hour.

It is set by hooks, not by the model: a hook fires exactly at the moment of waiting and knows
the session, the folder and the question text. Marks are one line per session in
$FORGE_MONITOR_HOME/waiting.tsv — the monitoring page reads this file and cannot
list a folder over HTTP, so there is only one file.

The script never fails the caller: any problem is a silent exit 0.
"""

import json
import os
import subprocess
import sys
import time

HOME = os.environ.get("FORGE_MONITOR_HOME") or os.path.expanduser("~/.config/forge-monitor")
FILE = os.path.join(HOME, "waiting.tsv")
STALE_HOURS = float(os.environ.get("FORGE_WAITING_STALE_HOURS", "1"))
MAX_MSG = 300
# Service commands do not describe a session: they start work, they are not the work.
SKIP_CMDS = {"/clear", "/model", "/rename", "/config", "/exit", "/compact", "/status",
             "/hooks", "/artifacts", "/help", "/cost", "/resume", "/login", "/logout"}


def project_of(cwd):
    """Project name — as forge-monitor names it: basename of the repository root."""
    if not cwd:
        return "-"
    try:
        out = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=5,
        )
        root = out.stdout.strip() or cwd
    except Exception:
        root = cwd
    return os.path.basename(root.rstrip("/")) or "-"


def label_of(transcript):
    """How the session started — this is how people find it.

    A session id in the banner is useless: one folder has several sessions, and
    eight hex characters do not tell you where to go to answer. The first
    message is usually a slash command, which is exactly what a person remembers.
    Read only the start of the file: a transcript can be thousands of lines.
    """
    if not transcript:
        return ""
    try:
        with open(transcript, encoding="utf-8") as f:
            for _ in range(200):
                line = f.readline()
                if not line:
                    break
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                if j.get("type") != "user":
                    continue
                c = (j.get("message") or {}).get("content")
                text = c if isinstance(c, str) else next(
                    (b.get("text", "") for b in (c or [])
                     if isinstance(b, dict) and b.get("type") == "text"), "")
                if not text:
                    continue
                # The first message of a session is often a harness service block —
                # it says nothing about the session, keep looking.
                stripped = text.lstrip()
                if stripped.startswith("<local-command-stdout>"):
                    continue                     # this is command output, not a request
                if stripped.startswith("<local-command-caveat>") or \
                        "Caveat: The messages below" in text[:200]:
                    if "<command-name>" not in text:
                        continue
                if "<command-name>" in text:
                    cmd = clean(text.split("<command-name>", 1)[1].split("</command-name>", 1)[0])
                    if cmd.split()[0] in SKIP_CMDS if cmd else True:
                        continue
                    return cmd[:60]
                return clean(text)[:60]
    except Exception:
        pass
    return ""


def read():
    try:
        with open(FILE, encoding="utf-8") as f:
            rows = [l.rstrip("\n").split("\t") for l in f if l.strip()]
    except FileNotFoundError:
        return []
    now = time.time()
    keep = []
    for r in rows:
        if len(r) < 4:
            continue
        try:
            # An abandoned session must not keep the banner forever.
            if now - float(r[0]) > STALE_HOURS * 3600:
                continue
        except ValueError:
            continue
        keep.append(r)
    return keep


def write(rows):
    """Write in place, with one write, without a temp file and a swap.

    An atomic swap would change the inode, and the file is mounted into the page
    container as a file — the bind-mount keeps the old inode, and the monitor would stay
    forever with the content it had at start. The file is tiny: one
    line per session, one system call, and the reader drops a broken line.
    """
    os.makedirs(HOME, exist_ok=True)
    data = "".join("\t".join(r) + "\n" for r in rows)
    with open(FILE, "w", encoding="utf-8") as f:
        f.write(data)


def clean(s):
    return " ".join(str(s or "").split())[:MAX_MSG]


def main():
    verb = sys.argv[1] if len(sys.argv) > 1 else ""

    if verb == "list":
        for r in read():
            print("\t".join(r))
        return

    if verb not in ("set", "clear"):
        print("forge-waiting: set | clear | list", file=sys.stderr)
        return

    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception:
        payload = {}

    session = clean(payload.get("session_id"))
    if not session:      # without a session the mark has nothing to attach to and nothing to clear it
        return
    rows = [r for r in read() if r[1] != session]

    if verb == "set":
        msg = clean(payload.get("message") or payload.get("prompt") or "waiting for input")
        rows.append([str(int(time.time())), session,
                     project_of(payload.get("cwd")), msg,
                     label_of(payload.get("transcript_path"))])

    write(rows)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:                      # monitoring must never break the session
        print("forge-waiting: %s" % e, file=sys.stderr)
    sys.exit(0)
