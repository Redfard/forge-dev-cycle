#!/usr/bin/env bash
# forge-monitor — set up the monitoring page on this machine.
#
#   forge-monitor <project path> [<path> ...]     declare which projects to watch
#   forge-monitor                                 show what is declared now
#
# Everything machine-specific lives in $FORGE_MONITOR_HOME (default ~/.config/forge-monitor):
# the project list, symlinks to their .forge and the compose file. Nothing appears in the plugin —
# it is shared and moves to another machine as is, while each machine has its own projects.

set -u

plugin=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
home=${FORGE_MONITOR_HOME:-$HOME/.config/forge-monitor}
port=${FORGE_PORT:-8903}

die() { printf 'forge-monitor: %s\n' "$1" >&2; exit 1; }

# --- project .forge: the same steps as in reference/config-lookup.md ----------
find_forge() {
  local p=$1 root common
  [ -d "$p" ] || { printf 'no such folder: %s\n' "$p" >&2; return 1; }
  root=$(git -C "$p" rev-parse --show-toplevel 2>/dev/null) || root=""
  common=$(git -C "$p" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=""
  [ -n "$common" ] && common=$(dirname "$common")
  for base in "$root" "$common"; do
    [ -n "$base" ] && [ -f "$base/.forge/config.yml" ] && { printf '%s\n' "$base/.forge"; return 0; }
  done
  for base in "$root" "$common"; do
    [ -n "$base" ] && [ -d "$base/.forge" ] && { printf '%s\n' "$base/.forge"; return 0; }
  done
  printf 'no .forge in %s — run /forge:init there\n' "$p" >&2
  return 1
}

show() {
  printf 'Monitoring folder: %s\n' "$home"
  if [ -s "$home/projects.tsv" ]; then
    printf 'Projects:\n'
    while IFS=$'\t' read -r name path; do printf '  %-20s %s\n' "$name" "$path"; done < "$home/projects.tsv"
  else
    printf 'No projects yet. To declare: forge-monitor <path> [<path> ...]\n'
    return 0
  fi
  printf '\nStart — either of the two:\n'
  printf '  python3 -m http.server --bind 127.0.0.1 --directory %s %s\n' "$home" "$port"
  printf '  docker compose -f %s/docker-compose.yml up -d\n' "$home"
  printf '\nOpen: http://127.0.0.1:%s\n' "$port"
  printf 'From another machine: ssh -f -N -L %s:localhost:%s <user>@<host>\n' "$port" "$port"
}

[ $# -eq 0 ] && { show; exit 0; }

# --- layout -------------------------------------------------------------------
mkdir -p "$home/forge" || die "cannot create $home"
: > "$home/projects.tsv.new"
rm -f "$home"/forge/* 2>/dev/null || true   # a declaration is the full list, not an addition

declare -A seen=()
mounts=""
for p in "$@"; do
  forge=$(find_forge "$p") || continue
  root=$(dirname "$forge")
  name=$(basename "$root")
  # Names clash more often than it seems: web, api, app in different repositories.
  if [ -n "${seen[$name]:-}" ]; then name="$(basename "$(dirname "$root")")-$name"; fi
  [ -n "${seen[$name]:-}" ] && name="$name-$(printf '%s' "$root" | cksum | cut -d' ' -f1)"
  seen[$name]=1

  ln -sfn "$forge" "$home/forge/$name" || die "cannot create symlink for $name"
  printf '%s\t%s\n' "$name" "$root" >> "$home/projects.tsv.new"
  mounts="$mounts      - \"$forge:/usr/share/nginx/html/forge/$name:ro\"
"
  printf 'watching: %-20s %s\n' "$name" "$root"
done

[ -s "$home/projects.tsv.new" ] || { rm -f "$home/projects.tsv.new"; die "no project was added"; }
mv "$home/projects.tsv.new" "$home/projects.tsv"

# Static files are symlinks into the plugin: they update when the plugin updates.
for f in index.html app.js style.css; do ln -sfn "$plugin/monitor/$f" "$home/$f"; done

# "Session is waiting for input" marks — hooks write them through bin/forge-waiting. Create
# the file in advance: when a mount source is missing, docker creates a folder
# in its place, and the page would get a folder instead of a file.
[ -e "$home/waiting.tsv" ] || : > "$home/waiting.tsv"

# The compose file is generated whole, not as an overlay on top of the plugin's one: the rules for merging
# volume lists would be extra knowledge here, and the plugin keeps no file
# that does not work on its own.
cat > "$home/docker-compose.yml" <<COMPOSE
# Generated by forge-monitor. Edits are overwritten on the next run.
services:
  forge-monitor:
    image: nginx:alpine
    restart: unless-stopped
    # 127.0.0.1 is required: otherwise docker publishes the port outside with its own
    # iptables rules — around ufw, and the port is open past the firewall.
    ports:
      - "127.0.0.1:${port}:80"
    # Static files are mounted one by one, not as a folder: inside a folder mounted
    # read-only, docker cannot create a mount point for projects.tsv.
    # A new page file means a new line here.
    volumes:
      - "${plugin}/monitor/index.html:/usr/share/nginx/html/index.html:ro"
      - "${plugin}/monitor/app.js:/usr/share/nginx/html/app.js:ro"
      - "${plugin}/monitor/style.css:/usr/share/nginx/html/style.css:ro"
      - "${home}/projects.tsv:/usr/share/nginx/html/projects.tsv:ro"
      - "${home}/waiting.tsv:/usr/share/nginx/html/waiting.tsv:ro"
${mounts}
COMPOSE


# File mounts keep the inode, and almost any editor replaces the file —
# after a plugin update the container keeps serving the old index.html.
# So a running container is recreated: this is the "apply the update" step.
if command -v docker >/dev/null 2>&1 &&
   [ -n "$(docker compose -f "$home/docker-compose.yml" ps -q 2>/dev/null)" ]; then
  if docker compose -f "$home/docker-compose.yml" up -d --force-recreate >/dev/null 2>&1; then
    printf 'container recreated — new static files applied\n'
  else
    printf 'could not recreate the container, do it yourself\n' >&2
  fi
fi

printf '\n'
show
